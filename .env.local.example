# Copy this file to `.env.local` and fill in real values for local development.
# Production values live in the Vercel dashboard:
#   https://vercel.com/murrayp4pcoalitions-projects/p4-p-website/settings/environment-variables
#
# Never commit `.env.local`. It is already in .gitignore.

# --- Power Hub authentication ---
PORTAL_USERNAME=p4padmin
PORTAL_PASSWORD=p4p2026

# --- Supabase (required to load any page that touches Power Hub auth) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- GitHub API (Power Hub commits content via this) ---
GITHUB_TOKEN=
GITHUB_OWNER=murrayp4pcoalition
GITHUB_REPO=P4P-Website
GITHUB_BRANCH=main

# --- Vercel Blob (asset uploads from Power Hub) ---
BLOB_READ_WRITE_TOKEN=

# --- Optional: manual deploy hook ---
VERCEL_DEPLOY_HOOK=
